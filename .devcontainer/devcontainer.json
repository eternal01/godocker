{
  // VSCode Dev Container config for the development-docker workspace.
  //
  // Use either way to get into the container:
  //   1. From VSCode: open this repo, run "Dev Containers: Reopen in Container"
  //      — VSCode reads this file, brings the workspace service up via
  //      docker compose, and applies the settings below automatically.
  //   2. From the CLI: `docker compose up -d workspace`, then in VSCode run
  //      "Dev Containers: Attach to Running Container" — in that case the
  //      `settings` block below is NOT applied; see README "IDE Integration"
  //      for the host-side setting to use instead.

  "name": "Development Workspace",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "containerUser": "developer",
  "remoteUser": "developer",

  "settings": {
    // Make zsh the default for VSCode's integrated terminal. The container's
    // login shell is /bin/zsh, but VSCode does not consult /etc/passwd — this
    // setting is what actually flips the integrated terminal.
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
      "zsh": {
        "path": "/bin/zsh",
        "args": ["-l"]
      },
      "bash": {
        "path": "/bin/bash"
      }
    }
  },

  // Extensions installed automatically when reopening in the container.
  // Add more here as the project grows; mise syntax-highlighting is the
  // most useful baseline since .mise.toml is now generated by detect-stack.
  "extensions": [
    "hverlin.mise-vscode"
  ],

  // Persist bash/zsh history across container rebuilds by bind-mounting a
  // named volume onto the workspace user's history files.
  "mounts": [
    "source=development-docker-bashhistory,target=/home/developer/.bash_history,type=volume",
    "source=development-docker-zshhistory,target=/home/developer/.zsh_history,type=volume",
    "source=development-docker-zsh-completion,target=/home/developer/.zsh-completion,type=volume"
  ]
}
